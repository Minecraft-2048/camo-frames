      "type": "minecraft:model",
      "model": "framedblocks:block/framed_slope"
    },
    "cases": [
      {
        "when": "gui",
        "model": { "type": "minecraft:model", "model": "framedblocks:block/framed_slope_icon" }
      },
      {
        "when": "fixed",
        "model": { "type": "minecraft:model", "model": "framedblocks:block/framed_slope_icon" }
      }
    ]
  }
}
