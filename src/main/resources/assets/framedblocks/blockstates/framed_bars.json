{
  "multipart": [
    {
      "apply": {
        "model": "framedblocks:block/framed_bars_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "framedblocks:block/framed_bars_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "framedblocks:block/framed_bars_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "framedblocks:block/framed_bars_side_alt",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "framedblocks:block/framed_bars_side_alt",
        "y": 270
      }
    }
  ]
}
